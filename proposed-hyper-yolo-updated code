        super().__init__(c1, c2, shortcut, g, k, e)
        self.hyper_const = DistanceHypergraphConstruction(c2)

    def forward(self, x):
        # Apply standard bottleneck logic then refine via Distance-Based Hypergraph Construction
        out = super().forward(x)
        return self.hyper_const(out)

