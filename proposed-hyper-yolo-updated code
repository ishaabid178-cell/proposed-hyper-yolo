### Improvement 4: Hyper-Attention Masking (HAM)
This module implements a dual-path attention mechanism. It computes both channel-wise and spatial-wise masks to refine feature maps, effectively suppressing background noise and improving the signal-to-noise ratio for small and dense objects.

import torch
import torch.nn as nn

class HyperAttentionMasking(nn.Module):
    """
    Improvement 4: Hyper-Attention Masking (HAM).
    Uses dual-path attention (Spatial + Channel) to refine high-order features.
    """
    def __init__(self, channels):
        super().__init__()
        # Channel Attention
        self.ca = nn.Sequential(
            nn.AdaptiveAvgPool2d(1),
            nn.Conv2d(channels, channels // 8, 1, bias=False),
            nn.ReLU(inplace=True),
            nn.Conv2d(channels // 8, channels, 1, bias=False),
            nn.Sigmoid()
        )
        # Spatial Attention
        self.sa = nn.Sequential(
            nn.Conv2d(2, 1, 7, padding=3, bias=False),
            nn.Sigmoid()
        )

    def forward(self, x):
        # 1. Apply Channel Attention
        x_ca = x * self.ca(x)
        
        # 2. Apply Spatial Attention (using max and mean pools along channel dim)
        avg_out = torch.mean(x_ca, dim=1, keepdim=True)
        max_out, _ = torch.max(x_ca, dim=1, keepdim=True)
        spatial_input = torch.cat([avg_out, max_out], dim=1)
        mask = self.sa(spatial_input)
        
        return x_ca * mask

